# --- Database (Neon / Supabase) ---
# DATABASE_URL = the POOLED connection string (host contains "-pooler"), used by the app at runtime.
# DIRECT_URL   = the UNPOOLED connection string, used only by `prisma migrate`.
# Locally (a plain Postgres) both are the same value.
DATABASE_URL="postgresql://user:pass@host-pooler/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Auth.js v5 ---
AUTH_SECRET="openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Email (Auth magic links + alarm fallback) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="Nothing Slips <alarms@yourdomain.com>"

# --- Web Push (VAPID). Generate: npx web-push generate-vapid-keys ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:you@yourdomain.com"

# --- Cron ---
# Vercel sends `Authorization: Bearer $CRON_SECRET` on scheduled invocations.
CRON_SECRET="openssl rand -hex 24"

# --- Optional Google Calendar two-way sync (isolated behind CalendarSyncProvider) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
